+async function exportCsv() {
+  const d = ST.drawer;
+  const msg = document.getElementById("csvMsg");
+  if (!d || !d.rows.length) { if (msg) msg.textContent = "Brak danych do eksportu"; return; }
+  let rows = d.rows;
+  if (d.total > d.rows.length && d.extra) {
