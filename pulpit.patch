+    s += `<rect class="hit" data-tip="${tip(`Staż <b>${esc(x.label)}</b> dni<br><b>${x.n}</b> ${pl(x.n, "odejście", "odejścia", "odejść")} · ${pct(x.n / total)} wszystkich`)}" x="0" y="${yy}" width="${W}" height="${rowH}"/>`;
